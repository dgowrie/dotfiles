#!/usr/bin/env bash
#
# git-bypass — temporarily disable GitHub branch protection rulesets
# to run a git command, then re-enable them.
#
# Usage: git bypass <git-command> [args...]
#   e.g. git bypass push origin main
#
# Place on $PATH to use as a git subcommand.

set -euo pipefail

RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
BOLD='\033[1m'
NC='\033[0m'

die()  { echo -e "${RED}${BOLD}ERROR:${NC} $*" >&2; exit 1; }
warn() { echo -e "${YELLOW}WARNING:${NC} $*" >&2; }
info() { echo -e "${GREEN}==>${NC} $*"; }

# --- Dependency checks ---

command -v gh  >/dev/null 2>&1 || die "gh (GitHub CLI) is required but not found"
command -v jq  >/dev/null 2>&1 || die "jq is required but not found"
command -v git >/dev/null 2>&1 || die "git is required but not found"

# --- Usage ---

if [[ $# -eq 0 ]]; then
  echo "Usage: git bypass <command> [args...]"
  echo "  e.g. git bypass push origin main"
  exit 1
fi

# --- Repo / branch discovery ---

repo=$(gh repo view --json nameWithOwner -q '.nameWithOwner' 2>/dev/null) \
  || die "Not in a GitHub repository (or gh auth failed)"

default_branch=$(gh repo view --json defaultBranchRef -q '.defaultBranchRef.name' 2>/dev/null) \
  || die "Could not determine default branch for ${repo}"

# --- Find active rulesets targeting the default branch ---

# List endpoint omits conditions; fetch each active ruleset individually
active_ids=()
while IFS=$'\t' read -r id; do
  [[ -z "$id" ]] && continue
  active_ids+=("$id")
done < <(
  gh api "repos/${repo}/rulesets" --paginate 2>/dev/null \
    | jq -r '.[] | select(.enforcement == "active") | "\(.id)"'
)

ruleset_ids=()
ruleset_names=()
branch_ref="refs/heads/${default_branch}"
for id in "${active_ids[@]}"; do
  name=$(
    gh api "repos/${repo}/rulesets/${id}" 2>/dev/null | jq -r \
      --arg ref "$branch_ref" \
      'select(.conditions.ref_name.include as $inc |
        ($inc | map(. == $ref or . == "~DEFAULT_BRANCH" or . == "~ALL") | any)) |
       .name'
  )
  if [[ -n "$name" ]]; then
    ruleset_ids+=("$id")
    ruleset_names+=("$name")
  fi
done

if [[ ${#ruleset_ids[@]} -eq 0 ]]; then
  warn "No active rulesets found targeting '${default_branch}' in ${repo}."
  warn "Running command directly."
  exec git "$@"
fi

# --- Confirmation prompt ---

echo -e "${BOLD}Repository:${NC}      ${repo}"
echo -e "${BOLD}Default branch:${NC}  ${default_branch}"
echo -e "${BOLD}Command:${NC}         git $*"
echo
echo -e "${BOLD}Rulesets to temporarily disable:${NC}"
for name in "${ruleset_names[@]}"; do
  echo "  - ${name}"
done
echo
read -rp "Proceed? [y/N] " confirm
[[ "$confirm" =~ ^[Yy]$ ]] || { echo "Aborted."; exit 1; }

# --- Helpers ---

disable_ruleset() {
  local id="$1"
  gh api "repos/${repo}/rulesets/${id}" 2>/dev/null \
    | jq '{name, target, enforcement: "disabled", bypass_actors, conditions, rules}' \
    | gh api "repos/${repo}/rulesets/${id}" --method PUT --input - >/dev/null 2>&1
}

enable_ruleset() {
  local id="$1"
  gh api "repos/${repo}/rulesets/${id}" 2>/dev/null \
    | jq '{name, target, enforcement: "active", bypass_actors, conditions, rules}' \
    | gh api "repos/${repo}/rulesets/${id}" --method PUT --input - >/dev/null 2>&1
}

# --- Cleanup: re-enable rulesets on exit (with retry) ---

disabled_ids=()

cleanup() {
  local failed=()

  for i in "${!disabled_ids[@]}"; do
    local id="${disabled_ids[$i]}"
    local name="${ruleset_names[$i]}"
    local max_retries=3
    local delay=2
    local success=false

    for ((attempt=1; attempt<=max_retries; attempt++)); do
      if enable_ruleset "$id"; then
        info "Re-enabled ruleset '${name}'"
        success=true
        break
      fi
      warn "Retry ${attempt}/${max_retries}: re-enabling '${name}'..."
      sleep "$delay"
      delay=$((delay * 2))
    done

    if [[ "$success" != true ]]; then
      failed+=("${id}:${name}")
    fi
  done

  if [[ ${#failed[@]} -gt 0 ]]; then
    echo >&2
    echo -e "${RED}${BOLD}=======================================================${NC}" >&2
    echo -e "${RED}${BOLD}  FAILED TO RE-ENABLE RULESETS — BRANCH UNPROTECTED    ${NC}" >&2
    echo -e "${RED}${BOLD}=======================================================${NC}" >&2
    echo >&2
    echo -e "${RED}Re-enable manually:${NC}" >&2
    for entry in "${failed[@]}"; do
      local fid="${entry%%:*}"
      local fname="${entry#*:}"
      echo >&2
      echo -e "  ${BOLD}${fname}${NC} (ID: ${fid}):" >&2
      echo "    gh api repos/${repo}/rulesets/${fid} \\" >&2
      echo "      | jq '{name, target, enforcement: \"active\", bypass_actors, conditions, rules}' \\" >&2
      echo "      | gh api repos/${repo}/rulesets/${fid} --method PUT --input -" >&2
    done
    echo >&2
  fi
}

trap cleanup EXIT

# --- Disable rulesets ---

for i in "${!ruleset_ids[@]}"; do
  id="${ruleset_ids[$i]}"
  name="${ruleset_names[$i]}"

  if disable_ruleset "$id"; then
    info "Disabled ruleset '${name}'"
    disabled_ids+=("$id")
  else
    die "Failed to disable ruleset '${name}' — aborting"
  fi
done

# --- Run the command ---

echo
info "Running: git $*"
echo

cmd_exit=0
git "$@" || cmd_exit=$?

echo

if [[ $cmd_exit -ne 0 ]]; then
  warn "Command exited with status ${cmd_exit}"
fi

# cleanup runs via EXIT trap
exit "$cmd_exit"
