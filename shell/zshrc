# nvm setup
# last modified 2026.02.18
export NVM_DIR="$HOME/.nvm"
[ -s "$(brew --prefix nvm)/nvm.sh" ] && \. "$(brew --prefix nvm)/nvm.sh"  # This loads nvm
[ -s "$(brew --prefix nvm)/etc/bash_completion.d/nvm" ] && \. "$(brew --prefix nvm)/etc/bash_completion.d/nvm"  # This loads nvm bash_completion

# The following lines have been added by Docker Desktop to enable Docker CLI completions.
fpath=(/Users/dggraf/.docker/completions $fpath)
autoload -Uz compinit
compinit
# End of Docker CLI completions
export PATH="$HOME/.local/bin:$PATH"

# Shell functions and helpers (Claude Code wrappers, worktree launcher, etc.)
# live in a sibling file so the test suite can source them in isolation.
# ${(%):-%x} is this file's own path; :A resolves the ~/.zshrc symlink to the
# repo copy, :h takes its directory - so functions.zsh loads regardless of where
# the repo is checked out.
source "${${(%):-%x}:A:h}/functions.zsh"
