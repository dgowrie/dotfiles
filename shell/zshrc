# nvm setup
# last modified 2026.02.18
export NVM_DIR="$HOME/.nvm"
[ -s "$(brew --prefix nvm)/nvm.sh" ] && \. "$(brew --prefix nvm)/nvm.sh"  # This loads nvm
[ -s "$(brew --prefix nvm)/etc/bash_completion.d/nvm" ] && \. "$(brew --prefix nvm)/etc/bash_completion.d/nvm"  # This loads nvm bash_completion

# The following lines have been added by Docker Desktop to enable Docker CLI completions.
fpath=(/Users/dggraf/.docker/completions $fpath)
autoload -Uz compinit
compinit
# End of Docker CLI completions
export PATH="$HOME/.local/bin:$PATH"

# Claude Code defaults: opus 4.6 (1M context) + medium effort. Pass extra flags to override.
claude() {
  command claude --model 'claude-opus-4-6[1m]' --effort medium "$@"
}
alias claude-high='command claude --model "claude-opus-4-7[1m]" --effort xhigh'

